    "Zero Brands: carousel": Content > Widgets > Add Widget, then where it
    shows (a page's container, e.g. Main Content Top on the home page), or
    inside any CMS page or block.
-->
<widgets xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Widget:etc/widget.xsd">
    <widget id="zero_brands_carousel" class="Zero\Brands\Block\Widget\Carousel" is_email_compatible="false"
            placeholder_image="Magento_Widget::placeholder.gif">
        <label translate="true">Zero Brands: carousel</label>
        <description translate="true">The logos of the brands this store sells, each linking to its page</description>
        <parameters>
            <parameter name="eyebrow" xsi:type="text" required="false" visible="true">
                <label translate="true">Eyebrow</label>
            </parameter>
            <parameter name="heading" xsi:type="text" required="false" visible="true">
                <label translate="true">Heading</label>
            </parameter>
            <parameter name="limit" xsi:type="text" required="false" visible="true">
                <label translate="true">Number of brands</label>
                <value>12</value>
            </parameter>
            <parameter name="template" xsi:type="select" required="true" visible="false">
                <label translate="true">Template</label>
                <options>
                    <option name="default" value="Zero_Brands::widget/carousel.phtml" selected="true">
                        <label translate="true">Carousel</label>
                    </option>
                </options>
            </parameter>
        </parameters>
    </widget>
</widgets>
