 * Zero CMS component "Brands: carousel" (etc/zero_cms/components.json): the
 * widget's block with the component's values.
 *
 * @var \Magento\Framework\View\Element\Template $block
 */
$v = (array) $block->getData('values');
/** @var \Zero\Brands\Block\Widget\Carousel $carousel */
$carousel = $block->getLayout()->createBlock(\Zero\Brands\Block\Widget\Carousel::class, '', ['data' => [
    'heading' => (string) ($v['heading'] ?? ''),
    'eyebrow' => (string) ($v['eyebrow'] ?? ''),
    'limit' => (int) ($v['limit'] ?? 12),
]]);
echo /* @noEscape */ $carousel->toHtml();
