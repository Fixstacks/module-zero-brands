 *
 * A brand page's head: logo and description (the brand's name is the page
 * title above), and the way back to all brands.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */
/** @var \Zero\Brands\ViewModel\Brands $brands */
$brands = $block->getData('view_model');
$brand = $brands->current();
if (!$brand) {
    return;
}
$logo = $brands->logoUrl($brand);
?>
<div class="zero-brand-header flex flex-col sm:flex-row gap-6 items-start mb-8">
    <?php if ($logo): ?>
        <div class="flex h-24 w-40 shrink-0 items-center justify-center border border-base-300 bg-base-100 p-3">
            <img src="<?= $escaper->escapeUrl($logo) ?>" alt="<?= $escaper->escapeHtmlAttr($brand['name']) ?>" class="max-h-full max-w-full object-contain">
        </div>
    <?php endif; ?>
    <div class="flex flex-col gap-3 min-w-0">
        <?php if (trim(strip_tags((string) $brand['description'])) !== ''): ?>
            <div class="prose prose-sm max-w-prose">
                <?= $escaper->escapeHtml($brand['description'], ['p', 'br', 'strong', 'em', 'b', 'i', 'ul', 'ol', 'li', 'a', 'h2', 'h3']) ?>
            </div>
        <?php endif; ?>
        <a href="<?= $escaper->escapeUrl($brands->indexUrl()) ?>" class="link link-neutral text-sm">&larr; <?= $escaper->escapeHtml(__('All brands')) ?></a>
    </div>
</div>
