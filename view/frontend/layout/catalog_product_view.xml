    The product's brand, linking to its page, by the product's name.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="product.info.main">
            <block class="Magento\Framework\View\Element\Template" name="zero.product.brand" template="Zero_Brands::product/brand.phtml" before="-">
                <arguments>
                    <argument name="view_model" xsi:type="object">Zero\Brands\ViewModel\Brands</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
